SERVER_PORT=8080

POSTGRES_AUTH_DB=postgresql://postgres:root@localhost:5432/evogo_auth?sslmode=disable
POSTGRES_USERS_DB=postgresql://postgres:root@localhost:5432/evogo_users?sslmode=disable
DATABASE_SAVE_MESSAGES=false
CLIENT_NAME=evolution

GLOBAL_API_KEY=429683C4C977415CAAFCCE10F7D57E11

# License — headless auto-activation by email.
# Set this to the email you used in your first manual license registration.
# On startup, the service will silently call /v1/register/auto and skip the
# browser flow. Falls back to the manual flow if the email isn't registered yet.
# Leave empty (or unset) to keep the default behavior (manual registration).
# EVOLUTION_OPERATOR_EMAIL=operator@example.com

WADEBUG=DEBUG
LOGTYPE=console
WEBHOOK_FILES=true

CONNECT_ON_STARTUP=true

OS_NAME=Evolution GO

# Memoria (fork PjgFactSalud). Los valores de fábrica ya son los de producción;
# se listan para poder ajustarlos desde el compose sin recompilar.
# GOGC / GOMEMLIMIT son los del runtime de Go: si no vienen en el entorno el
# binario aplica GOGC=50 y GOMEMLIMIT=96MiB.
# GOGC=50
# GOMEMLIMIT=96MiB
# GIN_MODE=release
# Descargar y decodificar el historial de chats (HistorySync) al vincular o
# reconectar. Apagado: nadie lo consume y cada chunk pesa decenas de MB.
# HISTORY_SYNC_DOWNLOAD=false
# Tope de cada POST de webhook saliente (segundos). Sin tope, un receptor
# colgado retiene goroutine, socket y payload por cada evento y reintento.
# WEBHOOK_TIMEOUT_SECONDS=90
# Forma del proto de los botones `reply` (/send/button) y de las listas
# (/send/list). `legacy` (fábrica) = ButtonsMessage / ListMessage envueltos en
# DocumentWithCaptionMessage. `viewonce` = ViewOnceMessage → InteractiveMessage
# → NativeFlow (quick_reply / single_select), el árbol que generan Baileys y
# Evolution API v2 y que los clientes actuales de Android/iOS sí pintan desde
# cuentas no oficiales. Ver README, "Botones y listas interactivas".
# INTERACTIVE_STYLE=legacy
# Flujos conversacionales: pasos de negocio (ia, correo, reporte, humano,
# pedido) por callback HTTP al pod. Sin URL esos pasos se degradan a texto.
# El secreto viaja en la cabecera X-Flow-Secret y debe coincidir con el del pod.
# FLOW_CALLBACK_URL=http://pod:8080/api/public/flow
# FLOW_CALLBACK_SECRET=cambia-esto
# Tope por callback en segundos (2-30, fábrica 8): es una conversación.
# FLOW_CALLBACK_TIMEOUT_SECONDS=8

# Passkey (WebAuthn) pairing — required only for accounts that ask for a passkey
# when linking a device. Set this to the PUBLIC base URL of THIS API, reachable
# by the browser where WhatsApp Web opens (the Evolution Passkey Helper extension
# calls it from the web.whatsapp.com origin). Use a public domain in production,
# or a tunnel (ngrok/cloudflared) / LAN IP in development — NOT localhost if the
# browser runs on another machine. See docs/wiki/guias-api/passkey-pairing.md.
# PASSKEY_PUBLIC_URL=https://your-api.example.com

# RabbitMQ, NATS y MinIO: la imagen de producción se compila SIN sus clientes
# (Dockerfile, GO_TAGS="... nominio nonats noamqp") y además sin SQLite
# (nosqlite: POSTGRES_AUTH_DB obligatorio). Con ese binario, definir AMQP_URL,
# NATS_URL o MINIO_ENABLED=true hace fallar el arranque con un mensaje claro;
# para usarlos, compile con --build-arg GO_TAGS="" (o `go build` a secas).
# Los valores de abajo sirven para un binario de desarrollo compilado completo.
AMQP_URL=amqp://admin:admin@localhost:5672/default
AMQP_GLOBAL_ENABLED=false

WEBHOOK_URL=https://webhook.site/2e6af2fa-6b04-497f-b4a1-13a905728d83

# Proxy Configuration
# PROXY_PROTOCOL can be http, https or socks5. If omitted, it is inferred from
# the port (1080/2080/42000-43000 → socks5; otherwise http).
# PROXY_PROTOCOL=http
# PROXY_HOST=proxy.example.com
# PROXY_PORT=8080
# PROXY_USERNAME=user
# PROXY_PASSWORD=secret

# Minio Configuration
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=evolution-media
MINIO_USE_SSL=false